# Copiar a .env (fuera de git) y rellenar con valores reales.
# rules/security-privacy.md: nunca hardcodear claves/tokens en el código.

# --- Postgres: dos roles a propósito, no uno solo ---
# cma_admin: dueño de las tablas, ejecuta migraciones/DDL. Nunca lo usa
# la aplicación en runtime.
POSTGRES_ADMIN_PASSWORD=changeme_local_dev_only
MIGRATIONS_DATABASE_URL=postgres://cma_admin:changeme_local_dev_only@localhost:5432/conversation_memory_assistant

# cma_app: rol de runtime, sin permiso de UPDATE/DELETE sobre evidencia
# (conversations/participants/messages/attachments) ni sobre
# system_audit_log. Lo crea/ajusta src/infrastructure/db/migrate.ts en
# cada corrida (idempotente), no Postgres al arrancar el contenedor.
APP_DB_PASSWORD=changeme_local_dev_only_app
DATABASE_URL=postgres://cma_app:changeme_local_dev_only_app@localhost:5432/conversation_memory_assistant

# `npm run test:integration` deriva automáticamente de las dos URLs de
# arriba una base de datos de test efímera (mismo servidor, sufijo
# `_test` en el nombre) — no hace falta configurar nada más
# (src/infrastructure/db/test-db.ts).

# Anthropic (proveedor de IA, consumido solo vía src/infrastructure/ai)
ANTHROPIC_API_KEY=

# Modelos por tarea (rules/agents-and-context.md: Haiku mecanico/barato,
# Sonnet desarrollo/uso general). Ajustar a los model IDs vigentes.
# Uso por pipeline (docs/DECISIONS.md, decisión de rag-engineer):
#   AI_MODEL_CHEAP   -> Entity Detection (UC-006, tier: "cheap")
#   AI_MODEL_DEFAULT -> Event Detection (UC-007, tier: "default")
AI_MODEL_DEFAULT=claude-sonnet-5
AI_MODEL_CHEAP=claude-haiku-4-5-20251001

# Voyage AI (proveedor de embeddings — Anthropic no expone endpoint propio,
# ver src/infrastructure/ai/anthropic-provider.ts). Consumido solo vía
# src/infrastructure/ai/voyage-embedding-provider.ts.
VOYAGE_API_KEY=

# Fijado por rag-engineer en la fase 05 (plans/,
# docs/DECISIONS.md: "Embeddings: proveedor, modelo, chunking, top-k y
# regeneración"). Vacio = la app debe fallar explicitamente al intentar
# generar embeddings, no asumir un default silencioso.
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_DIMENSIONS=1024

# Mapeo por defecto nombre_mostrado -> rol (docs/DATA_MODEL.md:
# participants.role) para participantes reales nuevos al importar/
# sincronizar. Mismo formato que --roles en cli-import.ts, que puede
# sobreescribir puntualmente esta base para una corrida sin tocar el
# .env. Vacío = un remitente nuevo queda en role='desconocido' hasta
# corregirlo a mano (docs/DECISIONS.md, entrada 2026-08-04). No poner
# nombres reales aquí, solo en tu .env local (rules/security-privacy.md).
PARTICIPANT_ROLE_MAP="Nombre1=organizador,Nombre2=miembro"

# Perfil de dominio (plans/): categorías de
# Case, dimensiones de análisis y contexto que se inyectan en los prompts.
# Vacío = perfil genérico incluido en el código. Ruta relativa a la raíz
# del repo (o absoluta); ver profiles/example.json para el formato.
# Los perfiles propios van en profiles/local/ (ignorado por git).
DOMAIN_PROFILE_PATH=

# Motores de IA (plans/). Nombres válidos hoy:
#   completions: anthropic-api | claude-code      embeddings: voyage
# Vacío = claude-code (completions, usa tu suscripción) y voyage (embeddings).
# Un nombre desconocido falla explícito al arrancar. Para usar saldo de API:
# AI_PROVIDER=anthropic-api y completar ANTHROPIC_API_KEY.
# AI_PROVIDER_CHEAP / AI_PROVIDER_DEFAULT permiten usar un motor distinto por
# tier (p. ej. uno para Entity Detection y otro para Event Detection).
AI_PROVIDER=
AI_PROVIDER_CHEAP=
AI_PROVIDER_DEFAULT=
EMBEDDING_PROVIDER=

# Motor `claude-code` (AI_PROVIDER=claude-code): usa la cuota de tu suscripción de
# Claude Code en lugar de saldo de API. Requiere Claude Code instalado y con
# sesión iniciada (`claude login`). El proveedor NO pasa ANTHROPIC_API_KEY al
# subproceso, para que nunca facture por API sin avisar.
# Los alias `haiku`/`sonnet` apuntan al modelo más reciente y cambian con el
# tiempo: para resultados reproducibles fijar un ID de modelo explícito.
CLAUDE_CODE_MODEL_CHEAP=
CLAUDE_CODE_MODEL_DEFAULT=
# Ruta de claude.exe si no está en el PATH (en Windows se resuelve solo).
CLAUDE_CLI_PATH=
# Tiempo máximo por llamada, en milisegundos (default 300000).
CLAUDE_CODE_TIMEOUT_MS=
