{
  "name": "conversation-memory-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Agente personal que archiva, indexa (RAG) y eventualmente responde una conversacion de WhatsApp.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "verify": "npm run verify --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @cma/core",
    "db:migrate": "npm run db:migrate -w @cma/core",
    "db:studio": "npm run db:studio -w @cma/core",
    "sync": "npm run sync -w @cma/core --",
    "process:metadata": "npm run process:metadata -w @cma/core --",
    "process:entities": "npm run process:entities -w @cma/core --",
    "process:events": "npm run process:events -w @cma/core --",
    "process:embeddings": "npm run process:embeddings -w @cma/core --",
    "ask": "npm run ask -w @cma/core --",
    "smoke:ai": "npm run smoke:ai -w @cma/core --",
    "smoke:embeddings": "npm run smoke:embeddings -w @cma/core --",
    "regression:questions": "npm run regression:questions -w @cma/core --",
    "regression:compare": "npm run regression:compare -w @cma/core --",
    "docs:diagrams": "node scripts/generate-diagrams.mjs"
  },
  "devDependencies": {
    "vite": "^7.3.7"
  }
}
