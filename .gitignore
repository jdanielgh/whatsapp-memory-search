node_modules/
dist/
.env
*.log
.DS_Store

# Estado local del hook de SessionStart (se regenera, no es evidencia)
.claude/state/

# Backups locales (backup-manager) - nunca al repo
*.dump
*.sql.gz
backups/

# Permisos locales de Claude Code: son por máquina y se acumulan solos
